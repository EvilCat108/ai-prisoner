# AI Prisoner's Dilemma Arena Configuration

# Database path (default: arena.db in current directory)
# For Docker: /app/data/arena.db
DB_PATH=arena.db

# Server port (default: 8080)
PORT=8080

# Optional: Slack webhook for GitHub Actions notifications
# Get from: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
