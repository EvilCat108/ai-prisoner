# AI Prisoner's Dilemma Arena — environment template
#
# Cloudflare Workers project. Secrets are NOT read from this file in
# production; use wrangler secret instead:
#
#   Local dev:      copy this file to `.dev.vars` and fill in the value
#   Production:     npx wrangler secret put DEEPSEEK_API_KEY --env production
#
# All non-secret config lives in wrangler.toml ([vars] / [env.production.vars]).

DEEPSEEK_API_KEY=your-deepseek-api-key-here
